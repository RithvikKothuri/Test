# .env.example - copy to .env and fill secrets (DO NOT COMMIT .env with real secrets)
# Runtime
PORT=3000
NODE_ENV=production

# GitHub (used when running with --publish). GITHUB_TOKEN must have repo:create and repo permissions.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_OWNER=your-github-org-or-user   # optional: org or user where repo will be created/pushed
GITHUB_REPO=your-repo-name             # optional: override default repo name

# OpenAI / LLM provider (if used by plugins)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Database (example placeholders)
# For sqlite (local dev):
DATABASE_URL=sqlite://./workdir/data/db.sqlite3
# For Postgres:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Logging / observability
LOG_LEVEL=info
SENTRY_DSN=

# CI / deploy helpers
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# NOTES:
# - Replace placeholder values above with production secrets via your secret manager.
# - Never store real API keys or credentials in git; use platform secrets or CI secret storage.
